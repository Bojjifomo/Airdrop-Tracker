# Copy this file to .streamlit/secrets.toml and fill in your real key.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# .streamlit/secrets.toml is gitignored — never commit the real key.
# On Streamlit Community Cloud, do NOT use this file: paste the key under
# App settings -> Secrets instead.
#
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY = "sk-ant-your-key-here"
